# Keep every text file on LF so the deterministic VPK packer emits
# byte-identical archives on Linux and Windows checkouts.
* text=auto
addon/** text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.nut text eol=lf
*.json text eol=lf
*.vdf text eol=lf
*.cfg text eol=lf
*.sp text eol=lf
